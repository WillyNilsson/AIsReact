# Sentry Error Tracking Configuration
# Copy this file to .env and fill in your Sentry DSN

# Sentry DSN (Data Source Name)
# Get this from your Sentry project settings at https://sentry.io
SENTRY_DSN=https://your-public-key@sentry.io/your-project-id

# Environment name (development, staging, production)
ENVIRONMENT=development

# Application version (optional, can be git commit hash)
APP_VERSION=unknown

# Traces sample rate (0.0 to 1.0)
# 0.1 means 10% of transactions will be sent to Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1

# Release tracking (optional)
# This can be automatically set from git commit in CI/CD
SENTRY_RELEASE=

# Additional Sentry options
SENTRY_DEBUG=false
SENTRY_ATTACH_STACKTRACE=true
SENTRY_SEND_DEFAULT_PII=false  # Don't send personally identifiable information
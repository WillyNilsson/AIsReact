# Django Settings
# SECURITY WARNING: Set DEBUG=False in production
DEBUG=False

# SECURITY WARNING: Generate a secure secret key for production
# Run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-CHANGE-IN-PRODUCTION

# Comma-separated list of allowed hosts (e.g., yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aisreact

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# JWT Settings
# Generate a secure JWT secret: python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET_KEY=your-jwt-secret-here-CHANGE-IN-PRODUCTION
JWT_ACCESS_TOKEN_LIFETIME=60  # minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # days

# AWS Settings for S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=aisreact-uploads
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=aisreact-uploads.s3.amazonaws.com
AWS_DEFAULT_ACL=private

# AI Provider API Keys
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-api-key-here

# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza...your-google-api-key-here

# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...your-anthropic-api-key-here

# Get your API key from: https://x.ai/api
XAI_API_KEY=xai-...your-xai-api-key-here

# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...your-deepseek-api-key-here

# Content Moderation API
MODERATION_API_KEY=your-moderation-api-key
MODERATION_API_URL=https://api.openai.com/v1/moderations

# Email Settings
# For development, use console backend (prints to console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use SendGrid or SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@aisreact.com
SERVER_EMAIL=noreply@aisreact.com
SUPPORT_EMAIL=support@aisreact.com

# SendGrid Configuration (recommended for production)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# SMTP Configuration (alternative to SendGrid)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Frontend URL (for email links)
FRONTEND_URL=https://aisreact.com

# Sentry (optional - for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Admin User (for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@aisreact.com
DJANGO_SUPERUSER_PASSWORD=change-this-password

# Logging and Monitoring
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Grafana for log visualization (optional)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# External log aggregation (optional)
# For production, you might use cloud services
# LOGSTASH_HOST=logstash.example.com
# LOGSTASH_PORT=5000
# DATADOG_API_KEY=your-datadog-api-key
# CLOUDWATCH_LOG_GROUP=aisreact-production
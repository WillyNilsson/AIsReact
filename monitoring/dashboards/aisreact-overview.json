{
  "dashboard": {
    "id": null,
    "uid": "aisreact-overview",
    "title": "aisreact Platform Overview",
    "tags": ["aisreact", "overview"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "type": "stat",
        "title": "Service Status",
        "targets": [
          {
            "expr": "sum(up{job=~\"aisreact-.*\"})",
            "legendFormat": "Services Up"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value",
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 3 },
                { "color": "green", "value": 4 }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "type": "stat",
        "title": "Total Posts (24h)",
        "targets": [
          {
            "expr": "increase(aisreact_posts_created_total[24h])",
            "legendFormat": "Posts"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 3,
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "type": "stat",
        "title": "Active Users (1h)",
        "targets": [
          {
            "expr": "aisreact_active_users",
            "legendFormat": "Active Users"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "type": "stat",
        "title": "Error Rate",
        "targets": [
          {
            "expr": "sum(rate(aisreact_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(aisreact_http_requests_total[5m])) * 100",
            "legendFormat": "Error %"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "type": "graph",
        "title": "Request Rate",
        "targets": [
          {
            "expr": "sum(rate(aisreact_http_requests_total[5m])) by (method)",
            "legendFormat": "{{method}}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "type": "graph",
        "title": "Response Time (95th percentile)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(aisreact_http_request_duration_seconds_bucket[5m])) by (endpoint, le))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Response Time"
          }
        ]
      },
      {
        "id": 7,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "type": "graph",
        "title": "AI Provider Performance",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(aisreact_ai_analysis_duration_seconds_bucket[5m])) by (provider, le))",
            "legendFormat": "{{provider}}"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Response Time"
          }
        ]
      },
      {
        "id": 8,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "type": "graph",
        "title": "Database Connections",
        "targets": [
          {
            "expr": "aisreact_database_connections_active",
            "legendFormat": "Active Connections"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [90],
                "type": "gt"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "Database connection pool alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 9,
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
        "type": "piechart",
        "title": "Post Status Distribution",
        "targets": [
          {
            "expr": "sum(aisreact_posts_created_total) by (content_type)",
            "legendFormat": "{{content_type}}"
          }
        ]
      },
      {
        "id": 10,
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
        "type": "piechart",
        "title": "Moderation Results",
        "targets": [
          {
            "expr": "sum(aisreact_posts_moderated_total) by (result)",
            "legendFormat": "{{result}}"
          }
        ]
      },
      {
        "id": 11,
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
        "type": "table",
        "title": "System Resources",
        "targets": [
          {
            "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU %",
            "format": "table",
            "instant": true
          },
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "Memory %",
            "format": "table",
            "instant": true
          },
          {
            "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
            "legendFormat": "Disk %",
            "format": "table",
            "instant": true
          }
        ]
      }
    ]
  },
  "overwrite": true
}
